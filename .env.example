SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
MTUMISHI_QGIS_RPC_PORT=65534
MTUMISHI_WORKER_ID=mtumishi-worker-vps-01
MTUMISHI_POLL_SECONDS=2
MTUMISHI_LEASE_SECONDS=120
MTUMISHI_DEFAULT_RESERVED_UNITS=12
MTUMISHI_DEFAULT_RUNTIME=native
MTUMISHI_MODEL_NAME=gemini-2.5-flash
MTUMISHI_WORKSPACES=.

# --- Geospatial RAG (Analog Finder - NASA Space Apps 2026) ---
# Hugging Face API key for Qwen3-VL-Embedding-8B (required in production)
HUGGINGFACE_API_KEY=your_hf_api_key_here
# Optional: custom Qwen-VL inference endpoint (leave empty to use HF Inference API)
QWEN_VL_ENDPOINT=
# Enable HTTP API server alongside the worker polling loop (1=enabled)
MTUMISHI_HTTP_ENABLED=1
# Port for the FastAPI HTTP server inside the container
MTUMISHI_HTTP_PORT=8000
# Host port published on the VPS (use 8085 or custom to avoid conflict with port 8000)
MTUMISHI_HOST_PORT=8085

# --- Automated Geospatial Ingestion Scheduler ---
# Enable periodic auto-ingestion daemon thread inside worker (1=enabled, 0=disabled)
GEOSPATIAL_AUTO_INGEST_ENABLED=1
# Ingestion interval in minutes (default: 360 = 6 hours)
GEOSPATIAL_AUTO_INGEST_INTERVAL_MINUTES=360
# Number of newly indexed clear tiles per cycle
GEOSPATIAL_AUTO_INGEST_BATCH_SIZE=5
# Maximum cloud cover allowed (percentage 0.0 - 100.0)
GEOSPATIAL_AUTO_INGEST_MAX_CLOUDS=15.0
# Target total number of indexed tiles before scheduler enters monitoring idle mode (0=unlimited)
GEOSPATIAL_AUTO_INGEST_TARGET_TOTAL=500
# Geological regions cycle (comma-separated or 'all' for full round-robin)
# Supported: katanga_copperbelt, kivu_maniema, virunga_volcanoes, kasai_craton, ituri_kilo_moto, cuvette_centrale, bas_congo
GEOSPATIAL_AUTO_INGEST_REGIONS=all
